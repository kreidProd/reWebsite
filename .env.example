# ── Client (VITE_ prefix = inlined into the public JS bundle at build time) ──
# Optional — overrides the committed default production pixel (943826127904095)
VITE_META_PIXEL_ID=
# Optional — overrides the committed default Calendly event link
VITE_CALENDLY_URL=

# ── Server-side (Cloudflare Pages → Settings → Environment variables) ──
# These are SECRETS read by functions/api/lead.js. NEVER give them a VITE_ prefix —
# that would inline them into the public bundle. Set them in the Cloudflare
# dashboard, not in a committed file.
# META_CAPI_TOKEN=          (required for server-side conversion events)
# META_DATASET_ID=          (optional — defaults to the pixel ID)
# META_TEST_EVENT_CODE=     (optional — routes CAPI events to Events Manager Test Events)
# ZAPIER_WEBHOOK_URL=       (lead forwarding to Zapier → ClickUp)
